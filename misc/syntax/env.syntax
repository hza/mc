# .env file syntax highlighting (dotenv format)

# Reference:
#   https://github.com/motdotla/dotenv

context default
    spellcheck
    keyword #*\n COMMENT_LINE
    keyword linestart \{ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz\}\[0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz.-\]= VARIABLE_OTHER
    keyword linestart export KEYWORD_OTHER
    keyword \s\{ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz\}\[0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz.-\]= VARIABLE_OTHER
    keyword whole true CONSTANT_LANGUAGE
    keyword whole false CONSTANT_LANGUAGE
    keyword ${*} VARIABLE_OTHER

    #=========================
    # Numbers
    # Digits glued to other text (ports, paths, versions) are not numbers.
    keyword \{:/.@\}\{0123456789\}\[0123456789\] base
    keyword whole \[-\]\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \[-\]\{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \[-\]\{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \[-\]\{0123456789\}\[0123456789\]\{eE\}\{\-\+\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \[-\]\{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \[-\]\{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\]\{eE\}\{\-\+\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC

context " " STRING_QUOTED_DOUBLE
    spellcheck
    keyword ${*} VARIABLE_OTHER
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\\{nrt\} CONSTANT_CHARACTER_ESCAPE

context ' ' STRING_QUOTED_SINGLE
    spellcheck
