# Sergej Pupykin <pupykin.s@gmail.com>

context default
    keyword whole linestart pkgbase VARIABLE_OTHER
    keyword whole linestart pkgname VARIABLE_OTHER
    keyword whole linestart epoch VARIABLE_OTHER
    keyword whole linestart pkgver VARIABLE_OTHER
    keyword whole linestart pkgrel VARIABLE_OTHER
    keyword whole linestart pkgdesc VARIABLE_OTHER
    keyword whole linestart arch VARIABLE_OTHER
    keyword whole linestart url VARIABLE_OTHER
    keyword whole linestart license VARIABLE_OTHER
    keyword whole linestart groups VARIABLE_OTHER
    keyword whole linestart depends VARIABLE_OTHER
    keyword whole linestart makedepends VARIABLE_OTHER
    keyword whole linestart optdepends VARIABLE_OTHER
    keyword whole linestart checkdepends VARIABLE_OTHER
    keyword whole linestart provides VARIABLE_OTHER
    keyword whole linestart conflicts VARIABLE_OTHER
    keyword whole linestart replaces VARIABLE_OTHER
    keyword whole linestart backup VARIABLE_OTHER
    keyword whole linestart options VARIABLE_OTHER
    keyword whole linestart install VARIABLE_OTHER
    keyword whole linestart source VARIABLE_OTHER
    keyword whole linestart noextract VARIABLE_OTHER
    keyword whole linestart backup VARIABLE_OTHER
    keyword whole linestart changelog VARIABLE_OTHER
    keyword whole linestart validpgpkeys VARIABLE_OTHER
    keyword whole linestart b2sums VARIABLE_OTHER
    keyword whole linestart md5sums VARIABLE_OTHER
    keyword whole linestart sha1sums VARIABLE_OTHER
    keyword whole linestart sha256sums VARIABLE_OTHER
    keyword whole linestart sha384sums VARIABLE_OTHER
    keyword whole linestart sha512sums VARIABLE_OTHER

    keyword whole linestart _cvsroot VARIABLE_OTHER
    keyword whole linestart _cvsmod VARIABLE_OTHER
    keyword whole linestart _svntrunk VARIABLE_OTHER
    keyword whole linestart _svnmod VARIABLE_OTHER
    keyword whole linestart _gitroot VARIABLE_OTHER
    keyword whole linestart _gitname VARIABLE_OTHER
    keyword whole linestart _hgroot VARIABLE_OTHER
    keyword whole linestart _hgrepo VARIABLE_OTHER
    keyword whole linestart _darcstrunk VARIABLE_OTHER
    keyword whole linestart _darcsmod VARIABLE_OTHER
    keyword whole linestart _bzrtrunk VARIABLE_OTHER
    keyword whole linestart _bzrmod VARIABLE_OTHER

    keyword whole $srcdir VARIABLE_OTHER
    keyword whole $pkgdir VARIABLE_OTHER
    keyword whole $startdir VARIABLE_OTHER
    keyword whole ${srcdir} VARIABLE_OTHER
    keyword whole ${pkgdir} VARIABLE_OTHER
    keyword whole ${startdir} VARIABLE_OTHER
    keyword whole $(srcdir) VARIABLE_OTHER
    keyword whole $(pkgdir) VARIABLE_OTHER
    keyword whole $(startdir) VARIABLE_OTHER

    keyword ;; KEYWORD_CONTROL
    keyword \\@ CONSTANT_CHARACTER_ESCAPE
    keyword \\$ CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
    keyword \\` CONSTANT_CHARACTER_ESCAPE
    keyword ` PUNCTUATION_SECTION
    keyword ; PUNCTUATION_TERMINATOR
    keyword $(*) VARIABLE_OTHER
    keyword ${*} VARIABLE_OTHER
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION

    keyword whole linestart #!\[\s\]*\n COMMENT_LINE black

    keyword $\* VARIABLE_OTHER
    keyword $@ VARIABLE_OTHER
    keyword $# VARIABLE_OTHER
    keyword $? VARIABLE_OTHER
    keyword $- VARIABLE_OTHER
    keyword $$ VARIABLE_OTHER
    keyword $! VARIABLE_OTHER
    keyword $_ VARIABLE_OTHER

    keyword wholeright $\[0123456789\] VARIABLE_OTHER

    keyword wholeright $+ VARIABLE_OTHER

    keyword $ VARIABLE_OTHER


    keyword wholeleft linestart function*() KEYWORD_OTHER_RESERVED
    keyword wholeleft linestart function\[\s\]+ KEYWORD_OTHER_RESERVED
    keyword wholeright +() KEYWORD_OPERATOR

wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._

    keyword whole alias SUPPORT_FUNCTION
    keyword whole bg SUPPORT_FUNCTION
    include sh-words.syntax
    keyword whole fg SUPPORT_FUNCTION

    keyword whole msg SUPPORT_FUNCTION

wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_

context # \n COMMENT_LINE
    spellcheck

context exclusive whole <<\[\s\]\[-\]\[\s\]\[\\\]EOF EOF STRING_QUOTED_OTHER
context exclusive whole <<\[\s\]\[-\]\[\s\]\[\\\]END END STRING_QUOTED_OTHER

context ' ' STRING_QUOTED_SINGLE

context " " STRING_QUOTED_DOUBLE
    keyword whole $srcdir VARIABLE_OTHER
    keyword whole $pkgdir VARIABLE_OTHER
    keyword whole $startdir VARIABLE_OTHER
    keyword whole ${srcdir} VARIABLE_OTHER
    keyword whole ${pkgdir} VARIABLE_OTHER
    keyword whole ${startdir} VARIABLE_OTHER
    keyword whole $(srcdir) VARIABLE_OTHER
    keyword whole $(pkgdir) VARIABLE_OTHER
    keyword whole $(startdir) VARIABLE_OTHER

    keyword \\* CONSTANT_CHARACTER_ESCAPE
    keyword \\@ CONSTANT_CHARACTER_ESCAPE
    keyword \\$ CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\` CONSTANT_CHARACTER_ESCAPE
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword $(*) VARIABLE_OTHER
    keyword ${*} VARIABLE_OTHER
    keyword $\* VARIABLE_OTHER
    keyword $@ VARIABLE_OTHER
    keyword $# VARIABLE_OTHER
    keyword $? VARIABLE_OTHER
    keyword $- VARIABLE_OTHER
    keyword $$ VARIABLE_OTHER
    keyword $! VARIABLE_OTHER
    keyword $_ VARIABLE_OTHER
    keyword wholeright $\[0123456789\] VARIABLE_OTHER

    keyword wholeright $+ VARIABLE_OTHER

    keyword $ VARIABLE_OTHER

context exclusive ` ` STRING_QUOTED_OTHER black
    keyword whole $srcdir VARIABLE_OTHER
    keyword whole $pkgdir VARIABLE_OTHER
    keyword whole $startdir VARIABLE_OTHER
    keyword whole ${srcdir} VARIABLE_OTHER
    keyword whole ${pkgdir} VARIABLE_OTHER
    keyword whole ${startdir} VARIABLE_OTHER
    keyword whole $(srcdir) VARIABLE_OTHER
    keyword whole $(pkgdir) VARIABLE_OTHER
    keyword whole $(startdir) VARIABLE_OTHER

    keyword '*' STRING_QUOTED_SINGLE
    keyword " STRING_QUOTED_DOUBLE
    keyword \\` CONSTANT_CHARACTER_ESCAPE
    keyword ; PUNCTUATION_TERMINATOR
    keyword ${*} VARIABLE_OTHER
    keyword $(*) VARIABLE_OTHER
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION

    keyword $\* VARIABLE_OTHER
    keyword $@ VARIABLE_OTHER
    keyword $# VARIABLE_OTHER
    keyword $? VARIABLE_OTHER
    keyword $- VARIABLE_OTHER
    keyword $$ VARIABLE_OTHER
    keyword $! VARIABLE_OTHER
    keyword $_ VARIABLE_OTHER

    keyword wholeright $\[0123456789\] VARIABLE_OTHER

    keyword wholeright $+ VARIABLE_OTHER

    keyword $ VARIABLE_OTHER

wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._

    include sh-words.syntax


context exclusive linestart options )
    keyword whole strip CONSTANT_OTHER
    keyword whole docs CONSTANT_OTHER
    keyword whole libtool CONSTANT_OTHER
    keyword whole emptydirs CONSTANT_OTHER
    keyword whole zipman CONSTANT_OTHER
    keyword whole ccache CONSTANT_OTHER
    keyword whole distcc CONSTANT_OTHER
    keyword whole buildflags CONSTANT_OTHER
    keyword whole makeflags CONSTANT_OTHER
    keyword whole debug CONSTANT_OTHER
    keyword whole upx CONSTANT_OTHER

    keyword whole !strip KEYWORD_OPERATOR
    keyword whole !docs KEYWORD_OPERATOR
    keyword whole !libtool KEYWORD_OPERATOR
    keyword whole !emptydirs KEYWORD_OPERATOR
    keyword whole !zipman KEYWORD_OPERATOR
    keyword whole !ccache KEYWORD_OPERATOR
    keyword whole !distcc KEYWORD_OPERATOR
    keyword whole !buildflags KEYWORD_OPERATOR
    keyword whole !makeflags KEYWORD_OPERATOR
    keyword whole !debug KEYWORD_OPERATOR
    keyword whole !upx KEYWORD_OPERATOR

context exclusive linestart arch )
    keyword whole any CONSTANT_OTHER
    keyword whole i686 CONSTANT_OTHER
    keyword whole x86_64 CONSTANT_OTHER
